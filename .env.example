# AdMob production placeholders (used only when VITE_ADS_TEST_MODE=0)
VITE_IOS_ADMOB_APP_ID=
VITE_IOS_INTERSTITIAL_UNIT_ID=
VITE_IOS_REWARDED_UNIT_ID=

VITE_ANDROID_ADMOB_APP_ID=
VITE_ANDROID_INTERSTITIAL_UNIT_ID=
VITE_ANDROID_REWARDED_UNIT_ID=

# Development safety defaults
# 1 = force test mode (recommended for local/dev)
VITE_ADS_TEST_MODE=1
# 1 = verbose ad logs
VITE_ADS_DEBUG=1
# 0 = disable rewarded flow wiring
VITE_ADS_ENABLE_REWARDED=1
# Optional comma-separated AdMob test device IDs for native QA
VITE_ADS_TEST_DEVICE_IDS=

# Notifications / reminders defaults
# 0 = reminders OFF by default (recommended)
VITE_REMINDER_DEFAULT_ENABLED=0
# Default reminder local hour [0..23]
VITE_REMINDER_DEFAULT_HOUR=18
# Rolling batch size [10..30]
VITE_REMINDER_BATCH_SIZE=12
# 1 = verbose notification logs
VITE_NOTIFICATION_DEBUG=1
