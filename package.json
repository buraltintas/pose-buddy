{
  "name": "pose-buddy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "assets:prepare": "node scripts/generate-native-assets.mjs",
    "assets:generate:ios": "npx @capacitor/assets generate --ios --assetPath assets",
    "assets:regen:ios": "npm run assets:prepare && npm run assets:generate:ios && npm run cap:sync:ios",
    "cap:add:ios": "npx cap add ios",
    "cap:sync:ios": "npx cap sync ios",
    "cap:open:ios": "npx cap open ios"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "vite": "^8.0.1"
  },
  "dependencies": {
    "@capacitor-community/admob": "^7.2.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/ios": "^8.3.0",
    "@capacitor/local-notifications": "^8.0.2",
    "phaser": "^3.90.0"
  }
}
